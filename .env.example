# Copy this file to .env (git-ignored) and fill in the values.
# Restart Expo with `npx expo start -c` after changing it.

# Supabase publishable key: Supabase dashboard → Project Settings → API Keys → Publishable key.
# Starts with sb_publishable_. Safe to ship in the app. Never put a secret / service_role key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: defaults to https://gflkukmbxjiggvobvitb.supabase.co
# EXPO_PUBLIC_SUPABASE_URL=https://gflkukmbxjiggvobvitb.supabase.co
